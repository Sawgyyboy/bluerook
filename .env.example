RETELL_API_KEY=
# Provisioned Retell number in E.164, used for outbound speed-to-lead calls.
RETELL_FROM_NUMBER=

# The n8n gate that sits in front of /api/lead. It holds the durable limits
# (one call per number per day, the daily ceiling), records the lead and
# notifies the team. Without these two the endpoint still works, but falls
# back to in-memory counters that reset whenever an instance recycles.
N8N_LEAD_WEBHOOK_URL=
# Value sent as the x-bluerook-token header. Must match the n8n credential.
N8N_LEAD_TOKEN=
# Server-side only. Powers /api/chat. Never expose this to the browser.
ANTHROPIC_API_KEY=
CALENDLY_ACCESS_TOKEN=
CALENDLY_EVENT_TYPE_URI=
RETELL_CALENDAR_TOOL_SECRET=

# Optional: set only when the Calendly event type requires these mappings.
CALENDLY_LOCATION_KIND=
CALENDLY_COMPANY_QUESTION=
CALENDLY_BOTTLENECK_QUESTION=
