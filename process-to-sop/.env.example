# ── AI provider ──────────────────────────────────────────────────────────────
# Option A (recommended): a direct Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Option B: route through the Vercel AI Gateway instead (leave ANTHROPIC_API_KEY
# unset and set this) — https://vercel.com/docs/ai-gateway
# AI_GATEWAY_API_KEY=vck_...

# Override the model if you want (defaults to claude-sonnet-5)
# SOP_MODEL=claude-sonnet-5

# ── Development helpers ──────────────────────────────────────────────────────
# Set to 1 to return a canned SOP without calling the AI — useful for working
# on the UI without a key. Never set this in production.
# SOP_MOCK=1

# ── Metadata ─────────────────────────────────────────────────────────────────
# Public URL of the deployed tool, used for canonical/Open Graph tags.
# NEXT_PUBLIC_SITE_URL=https://process-to-sop.vercel.app
